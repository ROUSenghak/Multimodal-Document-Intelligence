# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# OpenAI: live runs of notebooks/02_question_answering.ipynb; archive/course_labs/L1, L2, L3, L5
OPENAI_API_KEY=

# OpenRouter: paid E2 modes of notebooks/02_question_answering.ipynb (VISUALDOC_E2_MODE=smoke|pilot|full)
OPENROUTER_API_KEY=

# LandingAI ADE: archive/course_labs/L4, L4_II, L5 only
VISION_AGENT_API_KEY=

# notebooks/02_question_answering.ipynb (uses OPENAI_API_KEY above).
# replay (default) = no API call, reuse the frozen predictions.
# smoke / pilot / full = PAID calls; always go smoke -> pilot -> full.
VISUALDOC_QA_MODE=replay
# Optional override; the frozen results used this snapshot.
# VISUALDOC_QA_MODEL=gpt-4o-mini-2024-07-18
# E2 (Qwen3-VL-8B via OpenRouter): offline (default) sends nothing; smoke / pilot / full are PAID.
# VISUALDOC_E2_MODE=offline
