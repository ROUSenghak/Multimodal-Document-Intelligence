# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# OpenAI: used by notebooks/course_labs/L1, L2, L3, L5
OPENAI_API_KEY=

# LandingAI ADE: used by notebooks/course_labs/L4, L4_II, L5
VISION_AGENT_API_KEY=

# Answer generation in notebooks/project/14_mmlongbench_doc_benchmark.ipynb.
# Leave the model empty until the project's model choice is made; the
# notebook then stops at its readiness gate. Uses OPENAI_API_KEY above.
VISUALDOC_LLM_PROVIDER=openai
VISUALDOC_LLM_MODEL=
