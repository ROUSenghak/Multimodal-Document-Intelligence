.env
notebooks/course_labs/layoutreader/

# --- Secrets and credentials -------------------------------------------------
# Keep real keys in .env (ignored above); commit only .env.example.
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
credentials*.json
service-account*.json

# --- Python / tooling caches -------------------------------------------------
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.jupyter_cache/
build/
dist/

# --- Outputs written by the Lab notebooks ------------------------------------
# (Git has no trailing comments: a '#' after a pattern becomes part of it.)
# L5: vector store and parsed ADE chunks
notebooks/course_labs/chroma_db/
notebooks/course_labs/ade_outputs/
# L4_II: annotated pages and cropped chunks
notebooks/course_labs/results/
notebooks/course_labs/results_extracted/
notebooks/course_labs/page_*_annotated.png
notebooks/course_labs/page_annotated.png

# --- Project outputs (regenerable) --------------------------------------------
experiments/runs/
data/cache/
data/processed/
*.log

# --- Downloaded external benchmarks (see data/external/README.md) -------------
# Hugging Face download metadata, dataset caches, and lock files are machine
# specific (their names can embed absolute local paths) and are regenerated by
# the download cells. Files that were committed before these rules existed stay
# tracked until they are explicitly removed with `git rm --cached`.
data/external/**/.cache/
data/external/**/*.lock
data/external/**/*.incomplete
data/external/vidore/cache/
# MMLongBench-Doc PDFs are CC BY-NC 4.0 and downloaded on demand by
# notebooks/project/14_mmlongbench_doc_benchmark.ipynb.
data/external/mmlongbench_doc/documents/
# Hugging Face cache redirected into the project by notebooks (if any).
.hf_cache/
